# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
#
# See GCP_SETUP.md for how to obtain this key. Model calls use the Gemini
# Enterprise Agent Platform authorization-key path: the key is bound to a
# service account, but no service-account JSON key file is used locally.

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_API_KEY="YOUR_API_KEY_HERE"

# The generated Agents CLI server initializes Cloud Logging separately from
# model authentication. It needs local ADC plus a project hint. On a fresh
# machine, run `gcloud auth application-default login`, then set the project ID here.
# `GCLOUD_PROJECT` is intentionally used instead of `GOOGLE_CLOUD_PROJECT`;
# see ADR 0004.
GCLOUD_PROJECT="YOUR_PROJECT_ID"

# GOOGLE_GENAI_USE_ENTERPRISE is the current (Gemini Enterprise Agent
# Platform-branded) name for this flag. The older GOOGLE_GENAI_USE_VERTEXAI
# still works identically if you see it in older examples — don't set both
# to conflicting values, ENTERPRISE wins if you do.

# Do NOT set GOOGLE_CLOUD_PROJECT or GOOGLE_CLOUD_LOCATION here.
# If either is present, the SDK silently drops GOOGLE_API_KEY above and
# uses ADC for model authentication instead. See ADR 0003
# (docs/0003-no-project-location-env-vars.md). This is separate from the
# Cloud Logging ADC used by the generated local server.

# Alternative (not used by this guide): a Google AI Studio key instead of
# Vertex AI / Agent Platform. Simpler, but does NOT draw on GCP's $300 Free
# Trial credit.
# GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# GOOGLE_API_KEY=your-ai-studio-key-here
