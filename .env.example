# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
#
# See GCP_SETUP.md for how to obtain this key. This project uses the
# Gemini Enterprise Agent Platform (formerly "Vertex AI") API-key auth path,
# NOT Application Default Credentials (gcloud auth) and NOT a service account.

GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_API_KEY="YOUR_API_KEY_HERE"

# GOOGLE_GENAI_USE_ENTERPRISE is the current (Gemini Enterprise Agent
# Platform-branded) name for this flag. The older GOOGLE_GENAI_USE_VERTEXAI
# still works identically if you see it in older examples — don't set both
# to conflicting values, ENTERPRISE wins if you do.

# Do NOT set GOOGLE_CLOUD_PROJECT or GOOGLE_CLOUD_LOCATION here.
# If either is present, the SDK silently drops GOOGLE_API_KEY above and
# requires `gcloud auth application-default login` instead (out of scope
# for this prototype).

# Alternative (not used by this guide): a Google AI Studio key instead of
# Vertex AI / Agent Platform. Simpler, but does NOT draw on GCP's $300 Free
# Trial credit.
# GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# GOOGLE_API_KEY=your-ai-studio-key-here
